# Copy to .env to change defaults. No API keys are needed: the tool uses only free, open-source software.

# Where uploads, downloads and clips are stored
# CLIPPER_WORK_DIR=./workdir

# Largest upload accepted, in megabytes
# CLIPPER_MAX_UPLOAD_MB=2048

# Longest source video accepted, in minutes
# CLIPPER_MAX_SOURCE_MINUTES=240

# Use a specific FFmpeg program (optional; otherwise ffmpeg on PATH, then the bundled copy)
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
